+export default `
+/* ---- play mode: the game owns the whole window ---- */
+.qz-play>.file-card{max-width:none!important;width:100%;padding:0!important;gap:0!important;margin:0}
+.qz-play>.file-card>header,.qz-play>.file-card>footer,.qz-play .pj-choose,.qz-play .sea-back{display:none!important}
