+// Display-only replacement. No gameplay or audio state is changed.
+export function installRestartIcon(root){
+ const paint=()=>{for(const b of root.querySelectorAll('button')){if(!b.textContent.includes('العب المرحلة مرة أخرى')||b.querySelector('svg[data-restart-icon]'))continue;const text=b.textContent.replace('🔁','').trim();const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('viewBox','0 0 24 24');svg.setAttribute('width','17');svg.setAttribute('height','17');svg.setAttribute('aria-hidden','true');svg.setAttribute('data-restart-icon','');svg.style.cssText='display:inline-block;vertical-align:-3px;margin-inline-end:6px;flex-shrink:0';const path=document.createElementNS('http://www.w3.org/2000/svg','path');path.setAttribute('d','M4 10a8 8 0 1 1 1.6 7.2M4 4v6h6');path.setAttribute('fill','none');path.setAttribute('stroke','currentColor');path.setAttribute('stroke-width','2.2');path.setAttribute('stroke-linecap','round');path.setAttribute('stroke-linejoin','round');svg.append(path);b.replaceChildren(svg,document.createTextNode(text));}}
+ const observer=new MutationObserver(paint);observer.observe(root,{childList:true,subtree:true});paint();return()=>observer.disconnect();
+}
